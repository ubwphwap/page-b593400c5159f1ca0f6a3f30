);background:#fffdf8;padding:28px 26px}\n.plan + .plan{margin-top:-3px}\n.plan:nth-child(2){margin-left:22px}\n.plan:nth-child(3){margin-left:44px;background:var(--ivory-2)}\n.plan-top{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:10px;border-bottom:2px dashed rgba(43,26,28,.35);padding-bottom:14px;margin-bottom:16px}\n.plan-name{font-size:1.22rem;font-weight:800;letter-spacing:.04em}\n.price{font-size:1.5rem;font-weight:800;color:var(--wine);font-variant-numeric:tabular-nums}\n.price small{font-size:.74rem;font-weight:600;color:#6b5152;margin-left:2px}\n.annual{font-size:.8rem;color:#6b5152;margin-top:-8px;margin-bottom:16px}\n.badge{display:inline-block;background:var(--wine);color:var(--ivory);font-size:.7rem;letter-spacing:.16em;padding:3px 10px;margin-bottom:12px}\n.plan ul{list-style:none}\n.plan li{font-size:.92rem;padding-left:20px;position:relative;margin-bottom:7px;color:#43302f}\n.plan li::before{content:\"\";position:absolute;left:0;top:.62em;width:9px;height:9px;background:var(--wine)}\n.plan-note{font-size:.78rem;color:#7a6062;margin-top:16px;padding-top:12px;border-top:2px dashed rgba(43,26,28,.25)}\n\n/* 客户端 */\n.clients{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:0}\n.client{border:3px solid var(--line);background:#fffdf8;padding:22px}\n.client + .client{margin-left:-3px}\n.client-k{font-size:.72rem;letter-spacing:.18em;color:var(--wine);font-weight:700;margin-bottom:6px}\n.client p{font-size:.88rem;color:#4a3838}\n.client p + p{margin-top:8px}\n.client-link{font-size:.82rem;border-bottom:2px solid rgba(109,31,44,.3)}\n\n/* FAQ 分组 */\n.faq-group{margin-bottom:38px}\n.faq-group:last-child{margin-bottom:0}\n.faq-group-title{font-size:.8rem;letter-spacing:.22em;font-weight:800;color:var(--ivory);background:var(--wine);display:inline-block;padding:4px 12px;margin-bottom:16px}\n.faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:0}\n.q{border:3px solid var(--line);background:#fffdf8;padding:20px 20px 22px}\n.q:nth-child(2n){margin-left:-3px}\n.q:nth-child(n+3){margin-top:-3px}\n.q h4{font-size:.95rem;font-weight:800;margin-bottom:8px;color:var(--wine-deep);line-height:1.45}\n.q p{font-size:.88rem;color:#4a3838}\n\n/* 收尾 */\n.closing{margin:58px 54px 0;border:3px solid var(--line);background:var(--ivory-2);padding:32px 28px}\n.closing p{font-size:.95rem;max-width:38em}\n.closing p + p{margin-top:12px}\n.closing strong{color:var(--wine)}\nfooter{margin-top:44px;padding:26px 54px 0;border-top:3px solid var(--line);font-size:.78rem;color:#7a6062;display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px}\n\n@media (max-width:900px){\n.sidebar{display:none}\nsection{padding:42px 22px 0}\n.hero{padding:44px 22px 42px}\n.closing{margin:42px 22px 0;padding:26px 20px}\nfooter{padding:22px 22px 0;margin-top:34px}\n.plan:nth-child(2){margin-left:10px}\n.plan:nth-child(3){margin-left:20px}\n}\n@media (max-width:640px){\n.faq-grid{grid-template-columns:1fr}\n.q:nth-child(2n){margin-left:0}\n.q + .q{margin-top:-3px}\n.clients{grid-template-columns:1fr}\n.client + .client{margin-left:0;margin-top:-3px}\n.plan:nth-child(2),.plan:nth-child(3){margin-left:0}\n.plan + .plan{margin-top:-3px}\n.plan-top{flex-direction:column;align-items:flex-start}\n}\n</style><div class=\"layout\">\n<aside class=\"sidebar\">\n<a class=\"mark\" href=\"#top\">白 鲸</a>\n<div class=\"mark-sub\">使用说明 · 写给朋友</div>\n<nav>\n<ul class=\"toc\">\n<li><a href=\"#start\"><span class=\"toc-num\">01</span>从哪儿开始</a></li>\n<li><a href=\"#use\"><span class=\"toc-num\">02</span>日常怎么用</a></li>\n<li><a href=\"#plans\"><span class=\"toc-num\">03</span>三档方案</a></li>\n<li><a href=\"#clients\"><span class=\"toc-num\">04</span>客户端说明</a></li>\n<li><a href=\"#faq\"><span class=\"toc-num\">05</span>常见问题</a></li>\n</ul>\n</nav>\n<div class=\"side-note\">\n<b>先读这一句</b>\n页面里的价格与权益以白鲸正式公布的信息为准；本页没有给出的细节，就不要当成承诺。\n</div>\n</aside>\n\n<main id=\"top\">\n<div class=\"hero\">\n<span class=\"hero-tag\">白鲸 · 使用流程</span>\n<h1>白鲸 · 别急着研究参数，先按顺序把<em>四件事</em>做完</h1>\n<p class=\"hero-lead\">如果你刚听说白鲸，最省心的方式是跟着时间线走一遍：先挑方案，再装客户端，然后确认能正常使用，最后才去微调。下面每一步都写清了该看什么、该忽略什么。</p>\n\n<ol class=\"timeline\">\n<li>\n<span class=\"tl-dot\">01</span>\n<div class=\"tl-title\">先想清楚自己的用量</div>\n<div class=\"tl-desc\">一个人日常刷网页、看视频，和几个人一起用，需求完全不同。先估一下每月大概用多少、几台设备同时在线，再去对照方案，比反过来划算得多。</div>\n</li>\n<li>\n<span class=\"tl-dot\">02</span>\n<div class=\"tl-title\">选一档，不要一次买很久</div>\n<div class=\"tl-desc\">先按月走一段时间，确认设备数量、常用场景都够用，再考虑按年付。白鲸的方案差异主要写在流量和设备数上，读条款比看宣传语有用。</div>\n</li>\n<li>\n<span class=\"tl-dot\">03</span>\n<div class=\"tl-title\">装上客户端，按官方说明配置</div>\n<div class=\"tl-desc\">客户端只从白鲸给出的入口获取，配置信息也以账号内显示的为准。别人转发的配置文件、来路不明的安装包，一律不要用。</div>\n</li>\n<li>\n<span class=\"tl-dot\">04</span>\n<div class=\"tl-title\">用一周，再决定要不要调整</div>\n<div class=\"tl-desc\">刚装上的一两天体感容易失真。用满一周，看看自己常去的场景是否顺畅、设备数是否吃紧，再决定换档还是维持。</div>\n</li>\n</ol>\n</div>\n\n<section id=\"start\">\n<div class=\"sec-head\">\n<span class=\"sec-num\">01</span>\n<h2>从哪儿开始</h2>\n</div>\n<p class=\"sec-intro\">这一节不讲功能，只讲顺序。很多人卡住不是因为不会用，而是因为一上来就同时处理三件事：选方案、装软件、调设置。拆开做，反而快。</p>\n\n<div class=\"steps\">\n<div class=\"step\">\n<div class=\"step-no\">A</div>\n<h3>先记账式地列一遍自己的使用场景</h3>\n<p>拿张纸或者手机备忘录，写下三行：平时主要在哪些设备上用、每天大概用多久、有没有需要多台设备同时在线的时刻。这三行决定你该看哪一档方案，也是之后判断\"够不够\"的唯一依据。</p>\n<p>别用\"我觉得应该够\"来判断。写下来，一周后回头看，你会发现原来的估计往往偏差不小。</p>\n</div>\n<div class=\"step\">\n<div class=\"step-no\">B</div>\n<h3>把方案条款读一遍，重点是流量和设备数</h3>\n<p>白鲸三档方案的区别集中在两处：每月流量额度、可同时在线的设备数。其余权益写在方案卡里，逐条读，不要只看价格。价格最低的那档并不总是最省，关键看你的场景落在哪一档的区间内。</p>\n</div>\n<div class=\"step\">\n<div class=\"step-no\">C</div>\n<h3>账号信息只从自己手上走</h3>\n<p>账号、配置、客户端安装包，都从白鲸官方入口获取。任何人以\"帮你搞定\"为由索要账号信息的，都不要答应。这一条听起来啰嗦，但它是最省事的一条。</p>\n</div>\n</div>\n</section>\n\n<section id=\"use\">\n<div class=\"sec-head\">\n<span class=\"sec-num\">02</span>\n<h2>日常怎么用</h2>\n</div>\n<p class=\"sec-intro\">装好之后，真正的日常其实很简单。下面三件小事，做到就够用了。</p>\n\n<div class=\"card\">\n<h3>每周花两分钟看一眼用量</h3>\n<p>流量是按月计算的，很多人是在月底才发现额度不够。每周固定一个时间进账号看一眼余量，比月底手忙脚乱强。如果连续几周都在月中就接近上限，说明该考虑换档了。</p>\n</div>\n<div class=\"card card-soft\">\n<h3>设备数要留一点余量</h3>\n<p>方案里写的设备数是同时在线上限。手机、电脑、平板加在一起，很容易正好卡在边界上。日常留一台的余量，出门在外时就不会临时抢位置。</p>\n</div>\n<div class=\"card\">\n<h3>遇到问题先记录，再反馈</h3>\n<p>如果某次使用不顺畅，先记下时间、设备、当时在做什么。带着这几条去反馈，比只说\"用不了\"有效得多，也更容易被处理。</p>\n</div>\n</section>\n\n<section id=\"plans\">\n<div class=\"sec-head\">\n<span class=\"sec-num\">03</span>\n<h2>三档方案，阶梯式往上走</h2>\n</div>\n<p class=\"sec-intro\">下面三档是逐级递进的关系：设备越多、用量越大，往上走一档通常更合适。月付与年付的差别写在每档底部，年付相当于按十个月计价，但不是所有人都该一上来就年付。</p>\n\n<div class=\"plans\">\n<article class=\"plan\">\n<div class=\"plan-top\">\n<span class=\"plan-name\">基础版</span>\n<span class=\"price\">¥15<small>/月</small></span>\n</div>\n<p class=\"annual\">按年付 ¥150/年</p>\n<ul>\n<li>每月 100GB 流量额度</li>\n<li>3 台设备同时在线</li>\n<li>基础流媒体解锁</li>\n<li>普通线路节点池</li>\n</ul>\n<p class=\"plan-note\">适合一个人、一到两台设备、日常使用节奏比较轻的情况。</p>\n</article>\n\n<article class=\"plan\">\n<span class=\"badge\">多数人停在这一档</span>\n<div class=\"plan-top\">\n<span class=\"plan-name\">旗舰版</span>\n<span class=\"price\">¥35<small>/月</small></span>\n</div>\n<p class=\"annual\">按年付 ¥350/年</p>\n<ul>\n<li>每月 300GB 流量额度</li>\n<li>5 台设备同时在线</li>\n<li>全节点原生流媒体解锁</li>\n<li>IPLC 专线游戏加速优化</li>\n<li>7×24 优先工单支持</li>\n</ul>\n<p class=\"plan-note\">手机、电脑、平板全都要用，又希望线路更稳的情况，从这一档起步比较省心。</p>\n</article>\n\n<article class=\"plan\">\n<div class=\"plan-top\">\n<span class=\"plan-name\">团队版</span>\n<span class=\"price\">¥85<small>/月</small></span>\n</div>\n<p class=\"annual\">按年付 ¥850/年</p>\n<ul>\n<li>每月 1000GB 流量额度</li>\n<li>20 台设备同时在线</li>\n<li>VIP 专属高带宽节点</li>\n<li>支持企业定制路由</li>\n<li>专属客户经理服务</li>\n</ul>\n<p class=\"plan-note\">多设备、多人协作的场景用这一档。具体定制需求以与白鲸沟通确认的内容为准。</p>\n</article>\n</div>\n</section>\n\n<section id=\"clients\">\n<div class=\"sec-head\">\n<span class=\"sec-num\">04</span>\n<h2>客户端说明</h2>\n</div>\n<p class=\"sec-intro\">客户端只负责连上，不负责给你惊喜。安装前请确认来源，配置信息以账号内显示为准。下表按设备类型说明该注意什么。</p>\n\n<div class=\"clients\">\n<div class=\"client\">\n<div class=\"client-k\">桌面端</div>\n<h3>电脑</h3>\n<p>从白鲸给出的入口下载安装包，装完先用账号信息登录一次，确认配置已自动带出。</p>\n<p>系统提示安全确认时，按操作系统正常流程处理，不要为了跳过提示去装来源不明的\"补丁\"。</p>\n</div>\n<div class=\"client\">\n<div class=\"client-k\">移动端</div>\n<h3>手机与平板</h3>\n<p>移动端更依赖账号同步，登录后检查一次设备列表，确认没有多余设备占用名额。</p>\n<p>出门前提前试连一次，比到了现场再排查要省时间。</p>\n</div>\n<div class=\"client\">\n<div class=\"client-k\">账号</div>\n<h3>配置与设备管理</h3>\n<p>配置信息、设备列表、用量余量都在账号里看得到。改配置后先在单台设备上验证，确认正常再同步到其他设备。</p>\n<p>本页不提供下载地址；请通过白鲸官方渠道获取。</p>\n</div>\n</div>\n</section>\n\n<section id=\"faq\">\n<div class=\"sec-head\">\n<span class=\"sec-num\">05</span>\n<h2>常见问题，按主题分开说</h2>\n</div>\n<p class=\"sec-intro\">下面按\"选购\"\"安装\"\"日常\"\"账号\"四类分开写。找到你关心的那一类，答案就在里面。</p>\n\n<div class=\"faq-group\">\n<div class=\"faq-group-title\">选购</div>\n<div class=\"faq-grid\">\n<div class=\"q\">\n<h4>基础版和旗舰版差在哪里，值得多付吗？</h4>\n<p>差在流量额度、同时在线设备数和线路类型三处。如果你只有一台设备、用量不大，基础版就够了；如果手机加电脑都要用，旗舰版的 5 台设备和更大的流量额度通常更合适。</p>\n</div>\n<div class=\"q\">\n<h4>一下买一年划算吗？</h4>\n<p>年付价格低于按月累计，这是明面上的差别。但建议先用月付跑完一个完整周期，确认用量、设备数都合适，再转年付。先省下冲动，比先省下几十块更重要。</p>\n</div>\n<div class=\"q\">\n<h4>团队版需要提前说明什么？</h4>\n<p>团队版涉及多人多设备和定制路由，具体能做什么、需要提供哪些信息，以与白鲸沟通确认的内容为准。本页不代为承诺任何定制范围。</p>\n</div>\n<div class=\"q\">\n<h4>中途能换档吗？</h4>\n<p>换档涉及计费周期与权益衔接，具体规则请以白鲸账号内或官方说明为准。本页不代为解释计费细节，避免给你错误预期。</p>\n</div>\n</div>\n</div>\n\n<div class=\"faq-group\">\n<div class=\"faq-group-title\">安装</div>\n<div class=\"faq-grid\">\n<div class=\"q\">\n<h4>客户端从哪里下载？</h4>\n<p>只从白鲸官方渠道获取。本页不提供下载地址，也不推荐任何第三方镜像。来路不明的安装包一律不要装。</p>\n</div>\n<div class=\"q\">\n<h4>装好之后要手动填很多东西吗？</h4>\n<p>以账号内显示为准。通常登录后配置会自动带出，需要手动操作的步骤在客户端内会有指引。遇到看不懂的字段，先别改，问清楚再说。</p>\n</div>\n<div class=\"q\">\n<h4>为什么建议先在一台设备上试？</h4>\n<p>一次只改一处，出问题时才知道是哪一步引起的。多台同时动，排查成本会翻几倍，这是经验之谈。</p>\n</div>\n<div class=\"q\">\n<h4>换新设备要注意什么？</h4>\n<p>先看设备列表里还有没有旧设备的占位，避免新设备顶掉名额后自己却不知道。设备数上限是同时在线计算，不在线的一般不占用。</p>\n</div>\n</div>\n</div>\n\n<div class=\"faq-group\">\n<div class=\"faq-group-title\">日常</div>\n<div class=\"faq-grid\">\n<div class=\"q\">\n<h4>怎么知道自己快用完流量了？</h4>\n<p>进账号看当月的用量余量。养成每周看一次的习惯，比月底才发现额度见底要从容得多。</p>\n</div>\n<div class=\"q\">\n<h4>偶尔不顺畅，是方案不够吗？</h4>\n<p>不一定。先记录时间、设备、当时在做什么，再判断是场景问题还是方案问题。带着记录反馈，处理效率会高很多。</p>\n</div>\n<div class=\"q\">\n<h4>多人一起用会不会互相影响？</h4>\n<p>设备数和流量是两套限制，任何一项到顶都会影响体验。多人场景下建议直接从设备数更宽的那一档起步。</p>\n</div>\n<div class=\"q\">\n<h4>需要经常调设置吗？</h4>\n<p>不需要。装好、确认能用之后，日常基本不用碰设置。频繁改动往往是把本来正常的状态改坏。</p>\n</div>\n</div>\n</div>\n\n<div class=\"faq-group\">\n<div class=\"faq-group-title\">账号</div>\n<div class=\"faq-grid\">\n<div class=\"q\">\n<h4>账号信息能给别人吗？</h4>\n<p>不要。账号关联你的设备与用量，一旦外传，权益和设备名额都可能受影响。任何索要账号信息的\"帮忙\"，都请拒绝。</p>\n</div>\n<div class=\"q\">\n<h4>想了解计费、退款这类规则怎么办？</h4>\n<p>本页不代为说明这类规则，核实为准。请通过白鲸官方渠道查看正式条款，避免依据非官方说法做决定。</p>\n</div>\n<div class=\"q\">\n<h4>反馈问题时写什么最有用？</h4>\n<p>时间、设备、当时在做什么，三样齐了就好。再加一句\"之前是否正常\"，基本就够定位了。</p>\n</div>\n<div class=\"q\">\n<h4>这页写的内容会变吗？</h4>\n<p>方案与权益以白鲸正式公布的信息为准。本页只是把顺序和使用习惯讲清楚，不替代官方说明。</p>\n</div>\n</div>\n</div>\n</section>\n\n<div class=\"closing\">\n<p><strong>一句话总结：</strong>先估用量，再选方案；先装一台，再铺开；先跑一周，再谈调整。</p>\n<p>白鲸这套流程没什么玄机，重点在于顺序。按顺序做，你几乎不会遇到需要\"折腾\"的时刻；反过来，一上来就想把所有设置调到最优，往往是最费时间的那条路。</p>\n</div>\n\n<footer>\n<span>白鲸 · 使用说明</span>\n<span>价格与权益以官方公布信息为准</span>\n</footer>\n</main>\n</div>",
